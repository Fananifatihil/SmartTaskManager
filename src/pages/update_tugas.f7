<template>
    <div class="page" data-name="update_tugas">
        <!-- HEADER -->
        <div class="custom-header warna_dasar_sistem">
            <div class="header-top">
                <div>
                    <h1>Update Tugas</h1>
                    <p>Ubah detail tugas atau hapus tugas</p>
                </div>
                <a class="link icon-only close-page">
                    <i class="icon f7-icons text-color-white">xmark</i>
                </a>
            </div>
        </div>

        <!-- CONTENT -->
        <div class="page-content">
            <div class="form-wrapper">
                <div class="form-card">
                    <form id="form-update-tugas">
                        <div class="form-group">
                            <label>Judul Tugas</label>

                            <select id="judul" required>
                                <option value disabled selected>
                                    Masukkan judul tugas...
                                </option>
                                <option>Ujian Tengah Semester</option>
                                <option>PR Mingguan</option>
                                <option>Proyek Akhir</option>
                                <option value="lainnya">
                                    Lainnya...
                                </option>
                            </select>
                        </div>

                        <div class="form-group judul-custom-row"
                            style="display:none">
                            <label>Judul Manual</label>
                            <input type="text"
                                id="judul_custom"
                                placeholder="Masukkan judul tugas..." />
                        </div>

                        <div class="form-group">
                            <label>Mata Kuliah</label>
                            <input type="text"
                                id="mata_kuliah"
                                placeholder="Pilih matkul..." />
                        </div>

                        <div class="form-group">
                            <label>Deadline</label>
                            <input type="date" id="deadline" />
                        </div>

                        <div class="form-group">
                            <label>Status</label>
                            <select id="status">
                                <option value="belum">
                                    Belum selesai
                                </option>
                                <option value="selesai">
                                    Selesai
                                </option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Catatan (opsional)</label>

                            <textarea id="catatan"
                                rows="4"
                                placeholder="Tambahkan catatan..."></textarea>
                        </div>

                        <div class="block" style="display:flex;gap:8px">
                            <button type="submit"
                                class="button button-fill warna_dasar_sistem">Update</button>
                            <button type="button" id="btn-hapus"
                                class="button button-outline color-red">Hapus</button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</template>

<!-- Styles moved to src/css/custom.css -->

<script>
export default (props, { $, $on, $f7 }) => {
    $on('pageInit', () => {
        const page = $('.page[data-name="update_tugas"]');

        // close
        page.find('.close-page').on('click', (e) => {
            e.preventDefault();
            $f7.views.main.router.back();
        });

        // run async flow
        (async () => {
            // determine id from current route
            const currentRoute = $f7.views.main.router.currentRoute;
            const id = currentRoute && currentRoute.params ? currentRoute.params.id : null;

            if (!id) {
                $f7.dialog.alert('Task id tidak ditemukan');
                return;
            }

            // load task from IndexedDB if available, fallback to localStorage
            let task = null;
            try {
                if (window.dbFunctions) {
                    await window.dbFunctions.openDatabase();
                    task = await window.dbFunctions.getTask(id);
                } else {
                    const tasks = JSON.parse(localStorage.getItem('tasks') || '[]');
                    task = tasks.find(t => t.id === id);
                }
            } catch (err) {
                console.error('Failed to load task', err);
            }

            if (!task) {
                $f7.dialog.alert('Tugas tidak ditemukan');
                return;
            }

            // populate fields
            if (['Ujian Tengah Semester','PR Mingguan','Proyek Akhir'].includes(task.judul)) {
                page.find('#judul').val(task.judul).trigger('change');
                page.find('.judul-custom-row').hide();
            } else {
                page.find('#judul').val('lainnya').trigger('change');
                page.find('.judul-custom-row').show();
                page.find('#judul_custom').val(task.judul);
            }

            page.find('#mata_kuliah').val(task.mata_kuliah || '');
            page.find('#deadline').val(task.deadline || '');
            page.find('#status').val(task.status || 'belum');
            page.find('#catatan').val(task.catatan || '');

            // show custom input when select changes
            page.find('#judul').on('change', function () {
                if ($(this).val() === 'lainnya') {
                    page.find('.judul-custom-row').show();
                    page.find('#judul_custom').focus();
                } else {
                    page.find('.judul-custom-row').hide();
                }
            });

            // update handler
            page.find('#form-update-tugas').on('submit', async function (e) {
                e.preventDefault();

                const judulVal = page.find('#judul').val();
                let judul = '';
                if (judulVal === 'lainnya') {
                    judul = page.find('#judul_custom').val().trim();
                } else {
                    judul = judulVal;
                }

                const mata_kuliah = page.find('#mata_kuliah').val().trim();
                const deadline = page.find('#deadline').val();
                const status = page.find('#status').val();
                const catatan = page.find('#catatan').val();

                if (!judul) {
                    $f7.dialog.alert('Judul tugas wajib diisi');
                    return;
                }

                try {
                    if (window.dbFunctions) {
                        const updated = Object.assign({}, task, { judul, mata_kuliah, deadline, status, catatan });
                        await window.dbFunctions.updateTask(updated);
                    } else {
                        const all = JSON.parse(localStorage.getItem('tasks') || '[]');
                        const idx = all.findIndex(t => t.id === id);
                        if (idx === -1) { $f7.dialog.alert('Tugas tidak ditemukan'); return; }
                        all[idx] = Object.assign({}, all[idx], { judul, mata_kuliah, deadline, status, catatan });
                        localStorage.setItem('tasks', JSON.stringify(all));
                    }

                    try { window.dispatchEvent(new Event('tasksUpdated')); } catch(e){}
                    try { if ($f7 && $f7.emit) $f7.emit('tasksUpdated'); } catch(e){}

                    $f7.toast.create({ text: 'Tugas diperbarui', closeTimeout: 1200 }).open();
                    setTimeout(() => $f7.views.main.router.navigate('/tugas/', { reloadCurrent: true, ignoreCache: true, force: true }), 600);
                } catch (err) {
                    console.error('Update error', err);
                    $f7.dialog.alert('Gagal memperbarui tugas');
                }
            });

            // delete handler
            page.find('#btn-hapus').on('click', function () {
                $f7.dialog.confirm('Hapus tugas ini?', 'Konfirmasi', async () => {
                    try {
                        if (window.dbFunctions) {
                            await window.dbFunctions.deleteTask(id);
                        } else {
                            const all = JSON.parse(localStorage.getItem('tasks') || '[]');
                            const filtered = all.filter(t => t.id !== id);
                            localStorage.setItem('tasks', JSON.stringify(filtered));
                        }
                        try { window.dispatchEvent(new Event('tasksUpdated')); } catch(e){}
                        try { if ($f7 && $f7.emit) $f7.emit('tasksUpdated'); } catch(e){}
                        $f7.toast.create({ text: 'Tugas dihapus', closeTimeout: 1200 }).open();
                        setTimeout(() => $f7.views.main.router.navigate('/tugas/', { reloadCurrent: true, ignoreCache: true, force: true }), 600);
                    } catch (err) {
                        console.error('Delete error', err);
                        $f7.dialog.alert('Gagal menghapus tugas');
                    }
                });
            });

        })();
    });

    return $render;
}
</script>
